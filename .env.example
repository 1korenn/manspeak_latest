# ---------- frontend (exposed to the browser; VITE_ prefix) ----------
# mock = on-device demo, bookings stay in the visitor's browser (default)
# live = use the /api functions below (needs the Supabase vars)
VITE_API_MODE=mock

# ---------- server only (Vercel → Settings → Environment Variables) ----------
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: never prefix with VITE_

# Optional: SMS confirmations via Semaphore (https://semaphore.co)
SEMAPHORE_KEY=
SEMAPHORE_SENDER=MANSPEAK
